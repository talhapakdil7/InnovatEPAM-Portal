@model ErrorViewModel
@{
    Layout = null;
    ViewData["Title"] = "Error";
}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — InnovatEPAM Portal</title>
    <link rel="stylesheet" href="~/css/app.min.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-slate-100 flex items-center justify-center p-6">
    <div class="max-w-md w-full rounded-2xl border border-slate-200 bg-white shadow-lg p-8 text-center">
        <div class="w-14 h-14 mx-auto mb-4 rounded-full @(Model?.IsConcurrencyError == true ? "bg-amber-100 text-amber-600" : "bg-red-100 text-red-600") flex items-center justify-center">
            @if (Model?.IsConcurrencyError == true)
            {
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            }
            else
            {
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            }
        </div>
        
        @if (Model?.IsConcurrencyError == true)
        {
            <h1 class="text-lg font-bold text-slate-900">Changes in Progress</h1>
            <p class="text-sm text-slate-600 mt-2">@Model.ErrorMessage</p>
        }
        else
        {
            <h1 class="text-lg font-bold text-slate-900">Something went wrong</h1>
            <p class="text-sm text-slate-600 mt-2">
                @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
                {
                    @Model.ErrorMessage
                }
                else
                {
                    <span>We couldn't complete that action. Please try again, or contact an administrator if the problem continues.</span>
                }
            </p>
        }

        <div class="mt-6 flex flex-col sm:flex-row gap-2 justify-center">
            @if (Model?.IsConcurrencyError == true)
            {
                <button onclick="location.reload()" class="inline-flex items-center justify-center rounded-xl bg-amber-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-amber-700">Refresh & Retry</button>
                <a href="javascript:history.back()" class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Back</a>
            }
            else
            {
                <a asp-controller="Home" asp-action="Index" class="inline-flex items-center justify-center rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">Home</a>
                <a href="javascript:history.back()" class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Back</a>
            }
        </div>

        @if (Model?.ShowRequestId == true)
        {
            <p class="text-xs text-slate-500 mt-4">Request ID: @Model.RequestId</p>
        }
    </div>
</body>
</html>
