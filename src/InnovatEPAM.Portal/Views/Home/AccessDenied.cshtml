@{
    ViewData["Title"] = "Access Denied";
}

<div class="portal-empty text-center mx-auto" style="max-width:520px;">
    <div class="portal-empty-icon mb-4 text-danger-emphasis bg-danger-subtle rounded-4">
        <i class="bi bi-shield-lock"></i>
    </div>
    <h1 class="h3 fw-bold">Restricted workspace</h1>
    <p class="portal-input-hint mb-4">
        Your profile authenticates correctly, however this corridor requires elevated moderator entitlements.
    </p>
    <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
        <a asp-controller="Ideas" asp-action="Index" class="btn btn-primary rounded-3 fw-semibold px-4 shadow-sm">
            Return home
        </a>
        <a asp-controller="Auth" asp-action="Logout" class="btn btn-light border rounded-3 fw-semibold px-4">
            Switch identity
        </a>
    </div>
</div>
