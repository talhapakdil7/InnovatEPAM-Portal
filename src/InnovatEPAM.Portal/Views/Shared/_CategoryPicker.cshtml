@model string?

<div class="visually-hidden form-label" id="portalCategoryAssist">Innovation Category</div>
<select name="Category"
        id="categorySelect"
        class="form-select"
        tabindex="-1"
        aria-labelledby="portalCategoryAssist"
        style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0">
    <option value="">— Select a category —</option>
    @foreach (var cat in CategoryDefinitions.All.Values)
    {
        @if (Model == cat.Key)
        {
            <option value="@cat.Key" selected="selected">@cat.DisplayName</option>
        }
        else
        {
            <option value="@cat.Key">@cat.DisplayName</option>
        }
    }
</select>

<div class="portal-section-title mb-2">Innovation Category <span class="text-danger">*</span></div>
<p class="portal-input-hint mb-3">
    Pick the lane that fits best—specific fields unlock for reviewers downstream.
</p>

<div class="row row-cols-1 row-cols-md-3 g-3 mb-1" role="group" aria-label="Innovation category card picker">
    <div class="col">
        @{ var tech = CategoryDefinitions.All[CategoryDefinitions.TechnicalImprovement]; }
        <button type="button"
                class="portal-category-card h-100"
                aria-pressed="@(Model == tech.Key)"
                data-category-pick="@CategoryDefinitions.TechnicalImprovement">
            <div class="icon-wrap"><i class="bi bi-cpu"></i></div>
            <div class="fw-semibold">@tech.DisplayName</div>
            <p class="small portal-input-hint mt-2 mb-0">Platform, infra, engineering velocity, reliability.</p>
        </button>
    </div>
    <div class="col">
        @{ var proc = CategoryDefinitions.All[CategoryDefinitions.ProcessImprovement]; }
        <button type="button"
                class="portal-category-card h-100"
                aria-pressed="@(Model == proc.Key)"
                data-category-pick="@CategoryDefinitions.ProcessImprovement">
            <div class="icon-wrap"><i class="bi bi-diagram-3"></i></div>
            <div class="fw-semibold">@proc.DisplayName</div>
            <p class="small portal-input-hint mt-2 mb-0">Workflow quality, SLA, rework, throughput.</p>
        </button>
    </div>
    <div class="col">
        @{ var cli = CategoryDefinitions.All[CategoryDefinitions.ClientSolution]; }
        <button type="button"
                class="portal-category-card h-100"
                aria-pressed="@(Model == cli.Key)"
                data-category-pick="@CategoryDefinitions.ClientSolution">
            <div class="icon-wrap"><i class="bi bi-people"></i></div>
            <div class="fw-semibold">@cli.DisplayName</div>
            <p class="small portal-input-hint mt-2 mb-0">Client-facing value, monetization, satisfaction.</p>
        </button>
    </div>
</div>
