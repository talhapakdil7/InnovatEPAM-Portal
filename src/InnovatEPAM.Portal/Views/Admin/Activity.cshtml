@model AdminActivityViewModel
@{
    ViewData["Title"] = "Activity";
    ViewData["BreadcrumbParent"] = "Operations";
    ViewData["BreadcrumbParentUrl"] = Url.Action("Dashboard", "Admin");
}

<div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900">Live activity</h1>
    <p class="text-sm text-slate-500 mt-1">Workflow transitions and new submissions — driven by stored audit data.</p>
</div>

@if (Model.IsBlindReviewActive)
{
    <div class="alert-info mb-5">Blind review is active — some names may be masked.</div>
}

<div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
    <div class="card overflow-hidden">
        <div class="px-5 py-3.5 border-b border-slate-100 bg-slate-50/50">
            <h2 class="text-sm font-bold text-slate-800">Latest workflow actions</h2>
            <p class="text-xs text-slate-500 mt-0.5">Recent status changes</p>
        </div>
        <div class="divide-y divide-slate-50 max-h-[32rem] overflow-y-auto">
            @if (!Model.LatestWorkflowActions.Any())
            {
                <p class="text-sm text-slate-400 p-6">No transitions yet.</p>
            }
            @foreach (var ev in Model.LatestWorkflowActions)
            {
                <a href="@Url.Action("Detail", "Admin", new { id = ev.IdeaId })"
                   class="block px-5 py-3.5 hover:bg-slate-50/80 transition-colors">
                    <p class="text-sm font-semibold text-slate-900 line-clamp-1">@ev.IdeaTitle</p>
                    <p class="text-xs text-slate-600 mt-1">@ev.Summary</p>
                    <p class="text-[11px] text-slate-400 mt-1.5">@ev.ActorName · @ev.WhenUtc.ToString("MMM dd, yyyy HH:mm")</p>
                </a>
            }
        </div>
    </div>

    <div class="card overflow-hidden">
        <div class="px-5 py-3.5 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
            <div>
                <h2 class="text-sm font-bold text-slate-800">Recent submissions</h2>
                <p class="text-xs text-slate-500 mt-0.5">Newest ideas in the system</p>
            </div>
            <a href="@Url.Action("Index", "Admin")" class="text-xs font-semibold text-blue-600 hover:text-blue-700">Queue →</a>
        </div>
        <div class="divide-y divide-slate-50 max-h-[32rem] overflow-y-auto">
            @foreach (var idea in Model.RecentIdeas)
            {
                <a href="@Url.Action("Detail", "Admin", new { id = idea.Id })"
                   class="block px-5 py-3.5 hover:bg-slate-50/80 transition-colors">
                    <p class="text-sm font-semibold text-slate-900 line-clamp-1">@idea.Title</p>
                    <p class="text-xs text-slate-500 mt-1">@idea.SubmitterName · @idea.Status · @idea.CreatedDate.ToString("MMM dd HH:mm")</p>
                </a>
            }
        </div>
    </div>
</div>
