@model DecisionHistoryViewModel
@{
    ViewData["Title"] = "Decision history";

    string StatusBadgeClass(string status) => status switch
    {
        "Accepted" => "badge-accepted",
        "Rejected" => "badge-rejected",
        _ => "badge-draft"
    };

    string StatusLabel(string s) =>
        (s ?? "").Replace("Accepted", "Accepted", StringComparison.Ordinal)
                 .Replace("Rejected", "Rejected", StringComparison.Ordinal);

    string ShortDate(DateTime d) => d.ToString("dd.MM.yy");
}

@if (Model.IsBlindReviewActive)
{
    <div class="alert-info mt-4 mb-5">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
        </svg>
        <div>
            <span class="font-semibold">Blind review is on.</span>
            <a href="@Url.Action("BlindReview", "Settings")" class="underline ml-2 hover:opacity-70">Settings</a>
        </div>
    </div>
}

<div class="mt-4">
    <div class="page-header">
        <div>
            <div class="flex items-center gap-2 mb-0.5">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-widest">Decided ideas</span>
            </div>
            <h1 class="page-title">
                Decision history
                <span class="page-count-badge">@Model.Items.Count</span>
            </h1>
        </div>
        <a asp-action="Index" class="btn-ghost btn-sm self-start mt-1">All submissions</a>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="card">
            <div class="empty-state">
                <div class="w-16 h-16 mx-auto mb-4 bg-gray-100 rounded-2xl flex items-center justify-center">
                    <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-gray-700 mb-1">No records</h3>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
            @foreach (var idea in Model.Items)
            {
                var detailUrl = Url.Action("Detail", "Admin", new { id = idea.Id });
                var submitterTrim = idea.SubmitterName?.Trim();
                var initial = string.IsNullOrEmpty(submitterTrim) ? "?"
                    : char.ToUpperInvariant(submitterTrim[0]).ToString();
                var sameDay = idea.CreatedDate.Date == idea.LastModifiedDate.Date;
                <a href="@detailUrl"
                   class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-4 pb-3.5 shadow-[0_2px_12px_-4px_rgba(15,23,42,0.08)] hover:border-blue-200/90 hover:shadow-[0_8px_24px_-6px_rgba(37,99,235,0.18)] transition-all duration-200 flex flex-col min-h-[11.5rem]">
                    <div class="pointer-events-none absolute inset-x-0 top-0 h-0.5 bg-gradient-to-r from-blue-400/0 via-blue-400/40 to-indigo-400/0 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                    <div class="flex items-start justify-between gap-2 mb-2">
                        <h3 class="font-semibold text-slate-900 text-sm leading-snug line-clamp-2 group-hover:text-blue-700 transition-colors">@idea.Title</h3>
                        <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-xl bg-slate-50 text-slate-400 group-hover:bg-blue-50 group-hover:text-blue-600 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </span>
                    </div>
                    <div class="flex flex-wrap items-center gap-1.5 mb-3">
                        @if (!string.IsNullOrEmpty(idea.CategoryDisplayName))
                        {
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-indigo-50 text-indigo-700 border border-indigo-100/80">
                                @idea.CategoryDisplayName
                            </span>
                        }
                        <span class="@StatusBadgeClass(idea.Status) text-[10px] shadow-sm">@StatusLabel(idea.Status)</span>
                    </div>
                    <div class="mt-auto pt-3 border-t border-slate-100">
                        <div class="flex items-center gap-2 min-w-0">
                            <div class="w-7 h-7 rounded-full bg-gradient-to-br from-slate-200 to-slate-300 ring-2 ring-white shadow-sm flex items-center justify-center text-white text-[10px] font-bold flex-shrink-0">
                                @initial
                            </div>
                            <span class="text-slate-700 text-xs font-medium truncate min-w-0" title="@idea.SubmitterName">@idea.SubmitterName</span>
                            @if (idea.AttachmentCount > 0)
                            {
                                <span class="ml-auto flex items-center">
                                    <partial name="_AttachmentBadge" model="(idea.AttachmentCount, false)" />
                                </span>
                            }
                        </div>
                        <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[10px] text-slate-400 tabular-nums">
                            @if (sameDay)
                            {
                                <span class="inline-flex items-center gap-1 rounded-md bg-slate-50 px-1.5 py-0.5 text-slate-500">
                                    <svg class="w-3 h-3 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                    </svg>
                                    @ShortDate(idea.CreatedDate)
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-0.5" title="Submitted">
                                    <span class="text-slate-400 font-medium">Sub.</span>
                                    @ShortDate(idea.CreatedDate)
                                </span>
                                <span class="text-slate-200 select-none">·</span>
                                <span class="inline-flex items-center gap-0.5" title="Last updated">
                                    <span class="text-slate-400 font-medium">Upd.</span>
                                    @ShortDate(idea.LastModifiedDate)
                                </span>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>
