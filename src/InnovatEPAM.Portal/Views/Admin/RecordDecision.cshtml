@model InnovatEPAM.Portal.ViewModels.RecordDecisionViewModel
@{
    ViewData["Title"] = "Record Final Decision";
}

<div class="container py-4" style="max-width: 640px;">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Ideas</a></li>
            <li class="breadcrumb-item"><a asp-action="Detail" asp-route-id="@Model.IdeaId">@Model.IdeaTitle</a></li>
            <li class="breadcrumb-item active">Final Decision</li>
        </ol>
    </nav>

    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="bi bi-check2-circle me-2"></i>Record Final Decision</h5>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3">
                This idea has completed all review stages. Record the final outcome below.
                This action will update the idea's status and be permanently logged.
            </p>

            <table class="table table-sm mb-4">
                <tr>
                    <th class="text-muted" style="width:40%">Idea</th>
                    <td><strong>@Model.IdeaTitle</strong></td>
                </tr>
                <tr>
                    <th class="text-muted">Stage</th>
                    <td><span class="badge bg-dark">Final Decision</span></td>
                </tr>
            </table>

            <form asp-action="RecordDecision" method="post">
                <input type="hidden" asp-for="IdeaId" />
                <input type="hidden" asp-for="IdeaTitle" />

                <div class="mb-4">
                    <label class="form-label fw-semibold">Outcome <span class="text-danger">*</span></label>
                    <div class="d-flex gap-3">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="Outcome"
                                   id="outcomeAccepted" value="Accepted" />
                            <label class="form-check-label text-success fw-semibold" for="outcomeAccepted">
                                <i class="bi bi-check-circle me-1"></i>Accepted
                            </label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="Outcome"
                                   id="outcomeRejected" value="Rejected" />
                            <label class="form-check-label text-danger fw-semibold" for="outcomeRejected">
                                <i class="bi bi-x-circle me-1"></i>Rejected
                            </label>
                        </div>
                    </div>
                    <span asp-validation-for="Outcome" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label">Decision Notes <span class="text-muted">(optional)</span></label>
                    <textarea asp-for="Notes" class="form-control" rows="4"
                              placeholder="Summarize the rationale for this decision…" maxlength="1000"></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                    <div class="form-text">Max 1000 characters.</div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-dark">
                        <i class="bi bi-check2-circle me-1"></i>Record Decision
                    </button>
                    <a asp-action="Detail" asp-route-id="@Model.IdeaId" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
