@model List<InnovatEPAM.Portal.DTOs.IdeaListItemDTO>
@{
    ViewData["Title"] = $"Ideas at Stage: {ViewBag.StageName}";
}

<div class="d-flex align-items-center mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h2 class="mb-0">Stage: @ViewBag.StageName</h2>
    <span class="badge bg-primary ms-3">@Model.Count idea(s)</span>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        No ideas are currently at this stage.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Category</th>
                    <th>Submitted by</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var idea in Model)
                {
                    var badgeClass = idea.Status switch
                    {
                        "Submitted" => "bg-secondary",
                        "UnderReview" => "bg-warning text-dark",
                        "Accepted" => "bg-success",
                        "Rejected" => "bg-danger",
                        _ => "bg-secondary"
                    };
                    <tr>
                        <td>
                            <a asp-action="Detail" asp-route-id="@idea.Id" class="text-decoration-none fw-semibold">
                                @idea.Title
                            </a>
                        </td>
                        <td>
                            <span class="badge @badgeClass">
                                @idea.Status.Replace("UnderReview", "Under Review")
                            </span>
                        </td>
                        <td>
                            @if (idea.CategoryDisplayName != null)
                            {
                                <span class="badge bg-secondary">@idea.CategoryDisplayName</span>
                            }
                            else
                            {
                                <span class="text-muted small">Uncategorized</span>
                            }
                        </td>
                        <td class="small text-muted">@idea.SubmitterName</td>
                        <td class="small text-muted">@idea.CreatedDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            <a asp-action="Detail" asp-route-id="@idea.Id"
                               class="btn btn-sm btn-outline-primary">
                                Review <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
