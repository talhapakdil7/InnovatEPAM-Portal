@using InnovatEPAM.Portal.Models
@model AdminIdeaDetailViewModel
@{
    ViewData["Title"] = $"Review — {Model.Idea.Title}";
    var badgeClass = Model.Idea.Status switch
    {
        "Submitted" => "bg-secondary",
        "UnderReview" => "bg-warning text-dark",
        "Accepted" => "bg-success",
        "Rejected" => "bg-danger",
        _ => "bg-secondary"
    };
    var isUnderReview = Model.Idea.Status == "UnderReview";
    var canAdvance = isUnderReview && Model.Idea.CurrentReviewStageOrder < 4;
    var canRevert = isUnderReview && Model.Idea.CurrentReviewStageOrder > 1;
    var canDecide = isUnderReview && Model.Idea.IsAtFinalStage;
}

@if (Model.IsBlindReviewActive)
{
    <div class="alert alert-info d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-eye-slash-fill me-2 fs-5"></i>
        <div>
            <strong>Blind review is active</strong> — submitter identity is hidden during evaluation.
            @if (Model.Idea.Status == "Accepted" || Model.Idea.Status == "Rejected")
            {
                <span class="badge bg-success ms-2">
                    <i class="bi bi-eye me-1"></i>Identity visible — evaluation concluded
                </span>
            }
            else
            {
                <a asp-controller="Settings" asp-action="BlindReview" class="alert-link ms-2">Manage Settings</a>
            }
        </div>
    </div>
}

<div class="d-flex align-items-center mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
    <h2 class="mb-0 text-truncate">@Model.Idea.Title</h2>
    <span class="badge @badgeClass ms-3">@Model.Idea.Status.Replace("UnderReview", "Under Review")</span>
</div>

<div class="row g-4">
    <div class="col-lg-8">

        @* ── Evaluation Scoring Section ── *@
        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-star-fill text-warning"></i>
                <h6 class="mb-0">Evaluation Scores</h6>
            </div>
            <div class="card-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success py-2 mb-3"><i class="bi bi-check-circle me-1"></i>@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger py-2 mb-3"><i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]</div>
                }

                @if (Model.IsScoringAllowed)
                {
                    <form asp-controller="Score" asp-action="Submit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ScoreForm.IdeaId" />
                        <div class="row g-2 mb-3">
                            @foreach (var dim in new[] {
                                ("Innovation", "ScoreForm.Innovation", Model.ScoreForm.Innovation),
                                ("Technical Feasibility", "ScoreForm.TechnicalFeasibility", Model.ScoreForm.TechnicalFeasibility),
                                ("Business Impact", "ScoreForm.BusinessImpact", Model.ScoreForm.BusinessImpact),
                                ("Implementation Value", "ScoreForm.ImplementationValue", Model.ScoreForm.ImplementationValue)
                            })
                            {
                                <div class="col-sm-6 col-md-3">
                                    <label class="form-label small fw-semibold">@dim.Item1</label>
                                    <select name="@dim.Item2" class="form-select form-select-sm">
                                        <option value="">— Not scored —</option>
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <option value="@i" selected="@(dim.Item3 == i)">@i ★</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-sm btn-warning fw-semibold">
                                <i class="bi bi-star me-1"></i>Save Score
                            </button>
                            @if (Model.ScoreForm.Innovation.HasValue || Model.ScoreForm.TechnicalFeasibility.HasValue
                              || Model.ScoreForm.BusinessImpact.HasValue || Model.ScoreForm.ImplementationValue.HasValue)
                            {
                                <form asp-controller="Score" asp-action="Retract" asp-route-ideaId="@Model.Idea.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Remove your score for this idea?')">
                                        <i class="bi bi-x-circle me-1"></i>Remove My Score
                                    </button>
                                </form>
                            }
                        </div>
                    </form>
                }
                else if (Model.Idea.Status == "Accepted" || Model.Idea.Status == "Rejected")
                {
                    <div class="alert alert-secondary py-2 mb-3">
                        <i class="bi bi-lock me-1"></i><strong>Scoring closed</strong> — this idea has been decided.
                    </div>
                }

                @* Score summary — always shown when scores exist *@
                @if (Model.ScoreSummary != null && Model.ScoreSummary.ScorerCount > 0)
                {
                    <hr />
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-warning text-dark fs-6">@Model.ScoreSummary.OverallAverage?.ToString("F2") / 5</span>
                        <small class="text-muted">(@Model.ScoreSummary.ScorerCount reviewer(s))</small>
                    </div>
                    <table class="table table-sm table-bordered mb-2">
                        <thead class="table-light">
                            <tr>
                                <th>Dimension</th>
                                <th>Average</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td>Innovation</td><td>@(Model.ScoreSummary.AvgInnovation?.ToString("F2") ?? "—")</td></tr>
                            <tr><td>Technical Feasibility</td><td>@(Model.ScoreSummary.AvgTechnicalFeasibility?.ToString("F2") ?? "—")</td></tr>
                            <tr><td>Business Impact</td><td>@(Model.ScoreSummary.AvgBusinessImpact?.ToString("F2") ?? "—")</td></tr>
                            <tr><td>Implementation Value</td><td>@(Model.ScoreSummary.AvgImplementationValue?.ToString("F2") ?? "—")</td></tr>
                        </tbody>
                    </table>
                    @if (Model.ScoreSummary.AdminScores.Count > 0)
                    {
                        <details>
                            <summary class="small text-muted mb-1" style="cursor:pointer">Reviewer breakdown</summary>
                            <table class="table table-sm table-hover mt-1">
                                <thead class="table-light">
                                    <tr>
                                        <th>Reviewer</th>
                                        <th>Innov.</th>
                                        <th>Tech. Feas.</th>
                                        <th>Bus. Impact</th>
                                        <th>Impl. Value</th>
                                        <th>Row Avg</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.ScoreSummary.AdminScores)
                                    {
                                        <tr>
                                            <td>@row.AdminName</td>
                                            <td>@(row.Innovation?.ToString() ?? "—")</td>
                                            <td>@(row.TechnicalFeasibility?.ToString() ?? "—")</td>
                                            <td>@(row.BusinessImpact?.ToString() ?? "—")</td>
                                            <td>@(row.ImplementationValue?.ToString() ?? "—")</td>
                                            <td>@(row.RowAverage?.ToString("F2") ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </details>
                    }
                }
                else
                {
                    <div class="alert alert-light py-2 text-muted mb-0">
                        <i class="bi bi-star me-1"></i>No scores yet for this idea.
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Description</h5>
                @if (!string.IsNullOrWhiteSpace(Model.Idea.Description))
                {
                    <p>@Model.Idea.Description</p>
                }
                else
                {
                    <p class="text-muted fst-italic">No description provided.</p>
                }
            </div>
        </div>

        @if (Model.Idea.Attachments.Any())
        {
            <div class="card shadow-sm mt-3">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-paperclip me-1"></i>Attachments</h5>
                    <ul class="list-group list-group-flush">
                        @foreach (var att in Model.Idea.Attachments)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span><i class="bi bi-file-earmark me-2 text-muted"></i>@att.FileName</span>
                                <div class="d-flex align-items-center gap-2">
                                    <small class="text-muted">@((att.FileSize / 1024.0).ToString("F0")) KB</small>
                                    <a asp-controller="Ideas" asp-action="Download" asp-route-attachmentId="@att.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-download"></i>
                                    </a>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (Model.Idea.CategoryDataFields?.Any() == true)
        {
            <div class="card shadow-sm mt-3">
                <div class="card-header fw-semibold">
                    <i class="bi bi-tag me-2 text-primary"></i>@(Model.Idea.CategoryDisplayName ?? "Category") Details
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        @foreach (var field in Model.Idea.CategoryDataFields)
                        {
                            <dt class="col-sm-4">@field.Key</dt>
                            <dd class="col-sm-8" style="white-space:pre-wrap">@field.Value</dd>
                        }
                    </dl>
                </div>
            </div>
        }

        <div class="card shadow-sm mt-3 border-primary">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-arrow-repeat me-1"></i>Update Status
            </div>
            <div class="card-body">
                <form asp-action="UpdateStatus" method="post">
                    <input type="hidden" name="IdeaId" value="@Model.Idea.Id" />
                    <div class="row g-2 align-items-end">
                        <div class="col-auto">
                            <label for="NewStatus" class="form-label fw-semibold">New Status</label>
                            <select name="NewStatus" id="NewStatus" class="form-select">
                                @foreach (var status in Model.AllowedStatuses)
                                {
                                    <option value="@status" selected="@(Model.Idea.Status == status)">
                                        @status.Replace("UnderReview", "Under Review")
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i>Save
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @if (canAdvance || canRevert || canDecide)
        {
            <div class="card shadow-sm mt-3">
                <div class="card-header fw-semibold">
                    <i class="bi bi-diagram-3 me-1 text-primary"></i>Review Pipeline Actions
                </div>
                <div class="card-body d-flex flex-wrap gap-2">
                    @if (canAdvance && !canDecide)
                    {
                        <a asp-action="AdvanceStage" asp-route-id="@Model.Idea.Id"
                           class="btn btn-primary">
                            <i class="bi bi-arrow-right-circle me-1"></i>Advance Stage
                        </a>
                    }
                    @if (canDecide)
                    {
                        <a asp-action="RecordDecision" asp-route-id="@Model.Idea.Id"
                           class="btn btn-dark">
                            <i class="bi bi-check2-circle me-1"></i>Record Final Decision
                        </a>
                    }
                    @if (canRevert)
                    {
                        <a asp-action="RevertStage" asp-route-id="@Model.Idea.Id"
                           class="btn btn-outline-warning">
                            <i class="bi bi-arrow-left-circle me-1"></i>Revert Stage
                        </a>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        @if (Model.Idea.Status == "UnderReview" || Model.Idea.StageHistory.Any())
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header fw-semibold">
                    <i class="bi bi-diagram-3 me-1 text-primary"></i>Review Progress
                </div>
                <div class="card-body">
                    @{
                        var stages = new[] { "Initial Screening", "Technical Review", "Business Impact Assessment", "Final Decision" };
                        var currentOrder = Model.Idea.CurrentReviewStageOrder;
                    }
                    <div class="d-flex flex-column gap-2">
                        @for (int i = 1; i <= 4; i++)
                        {
                            var isDone = i < currentOrder;
                            var isCurrent = i == currentOrder;
                            var iconClass = isDone ? "bi-check-circle-fill text-success"
                                : isCurrent ? "bi-record-circle-fill text-primary"
                                : "bi-circle text-muted";
                            <div class="d-flex align-items-center gap-2 @(isCurrent ? "fw-semibold" : "text-muted")">
                                <i class="bi @iconClass fs-5"></i>
                                <span class="small">@stages[i - 1]</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="text-muted mb-3">Submission Details</h6>
                <dl class="row mb-0">
                    <dt class="col-5">Submitted by</dt>
                    <dd class="col-7">@Model.Idea.SubmitterName</dd>
                    <dt class="col-5">Category</dt>
                    <dd class="col-7">
                        @if (Model.Idea.CategoryDisplayName != null)
                        {
                            <span class="badge bg-secondary">@Model.Idea.CategoryDisplayName</span>
                        }
                        else
                        {
                            <span class="text-muted">Uncategorized</span>
                        }
                    </dd>
                    <dt class="col-5">Created</dt>
                    <dd class="col-7">@Model.Idea.CreatedDate.ToString("MMM dd, yyyy")</dd>
                    <dt class="col-5">Last updated</dt>
                    <dd class="col-7">@Model.Idea.LastModifiedDate.ToString("MMM dd, yyyy")</dd>
                </dl>
            </div>
        </div>

        @if (Model.Idea.AuditHistory.Any())
        {
            <div class="card shadow-sm mt-3">
                <div class="card-body">
                    <h6 class="text-muted mb-3">Status History</h6>
                    <ul class="list-unstyled mb-0">
                        @foreach (var log in Model.Idea.AuditHistory)
                        {
                            <li class="mb-2 small">
                                <i class="bi bi-arrow-right-circle text-primary me-1"></i>
                                <strong>@log.OldStatus</strong> → <strong>@log.NewStatus</strong>
                                <br />
                                <span class="text-muted">by @log.ChangedByAdmin on @log.ChangedDate.ToString("MMM dd, yyyy")</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (Model.Idea.StageHistory.Any())
        {
            <div class="card shadow-sm mt-3">
                <div class="card-header fw-semibold">
                    <i class="bi bi-clock-history me-1 text-secondary"></i>Stage History
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var t in Model.Idea.StageHistory)
                        {
                            var directionIcon = t.IsAdvance ? "bi-arrow-right-circle-fill text-primary" : "bi-arrow-left-circle-fill text-warning";
                            <li class="list-group-item small">
                                <div class="d-flex align-items-center gap-1 mb-1">
                                    <i class="bi @directionIcon"></i>
                                    @if (t.FromStageName != null)
                                    {
                                        <span>@t.FromStageName</span>
                                        <i class="bi bi-arrow-right text-muted"></i>
                                    }
                                    <strong>@t.ToStageName</strong>
                                    @if (!string.IsNullOrEmpty(t.Outcome))
                                    {
                                        var outcomeClass = t.Outcome == "Accepted" ? "bg-success" : "bg-danger";
                                        <span class="badge @outcomeClass ms-1">@t.Outcome</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(t.RevertReason))
                                {
                                    <div class="text-muted fst-italic">Reason: @t.RevertReason</div>
                                }
                                @if (!string.IsNullOrEmpty(t.Notes))
                                {
                                    <div class="text-muted">@t.Notes</div>
                                }
                                <div class="text-muted mt-1">
                                    by @t.TransitionedByAdminName · @t.TransitionDate.ToString("MMM dd, yyyy HH:mm")
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
</div>
