@model AdminDashboardViewModel
@{
    string StatusBadgeClass(string status) => status switch
    {
        "Submitted" => "badge-submitted",
        "UnderReview" => "badge-review",
        "Accepted" => "badge-accepted",
        "Rejected" => "badge-rejected",
        _ => "badge-draft"
    };
    string StatusLabel(string s) => s?.Replace("UnderReview", "Under Review") ?? "";
}

<div class="space-y-6 mb-8">

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
        <div class="card overflow-hidden flex flex-col min-h-0">
            <div class="px-5 py-3.5 border-b border-slate-100 flex items-center justify-between gap-2 bg-slate-50/50">
                <h2 class="text-sm font-semibold text-slate-800">All ideas</h2>
                <span class="text-xs text-slate-500 tabular-nums">@Model.AllIdeas.Count records</span>
            </div>
            <div class="overflow-x-auto overflow-y-auto max-h-[min(28rem,55vh)]">
                @if (!Model.AllIdeas.Any())
                {
                    <p class="text-sm text-slate-500 p-6">No submissions yet.</p>
                }
                else
                {
                    <table class="data-table text-sm">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Submitter</th>
                                <th>Status</th>
                                <th>Updated</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var idea in Model.AllIdeas)
                            {
                                <tr class="hover:bg-slate-50/80">
                                    <td class="font-medium text-slate-900 max-w-[14rem]">
                                        <a href="@Url.Action("Detail", "Admin", new { id = idea.Id })" class="text-blue-700 hover:underline line-clamp-2">@idea.Title</a>
                                    </td>
                                    <td class="text-slate-600 whitespace-nowrap max-w-[10rem] truncate" title="@idea.SubmitterName">@idea.SubmitterName</td>
                                    <td><span class="@StatusBadgeClass(idea.Status)">@StatusLabel(idea.Status)</span></td>
                                    <td class="text-xs text-slate-500 whitespace-nowrap">@idea.LastModifiedDate.ToString("MMM dd, HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="card overflow-hidden flex flex-col min-h-0">
            <div class="px-5 py-3.5 border-b border-slate-100 flex items-center justify-between gap-2 bg-slate-50/50">
                <h2 class="text-sm font-semibold text-slate-800">All users</h2>
                <span class="text-xs text-slate-500 tabular-nums">@Model.AllUsers.Count records</span>
            </div>
            <div class="overflow-x-auto overflow-y-auto max-h-[min(28rem,55vh)]">
                @if (!Model.AllUsers.Any())
                {
                    <p class="text-sm text-slate-500 p-6">No users.</p>
                }
                else
                {
                    <table class="data-table text-sm">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model.AllUsers)
                            {
                                <tr class="hover:bg-slate-50/80">
                                    <td class="font-medium text-slate-900 whitespace-nowrap">@u.FullName</td>
                                    <td class="text-slate-600 max-w-[12rem] truncate" title="@u.Email">@u.Email</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="card p-5">
        <div class="flex items-center justify-between mb-3">
            <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-widest">Latest status changes</h3>
            <a href="@Url.Action("Activity", "Admin")" class="text-xs font-semibold text-blue-600 hover:text-blue-700">Activity →</a>
        </div>
        @if (!Model.LatestWorkflowActions.Any())
        {
            <p class="text-sm text-slate-400">No status changes yet.</p>
        }
        else
        {
            <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var ev in Model.LatestWorkflowActions)
                {
                    <li class="text-xs border border-slate-100 rounded-xl p-3 bg-slate-50/50">
                        <a href="@Url.Action("Detail", "Admin", new { id = ev.IdeaId })" class="font-semibold text-slate-800 hover:text-blue-600 line-clamp-2">@ev.IdeaTitle</a>
                        <p class="text-slate-600 mt-1 line-clamp-2">@ev.Summary</p>
                        <p class="text-slate-400 mt-2">@ev.ActorName · @ev.WhenUtc.ToString("MMM dd HH:mm")</p>
                    </li>
                }
            </ul>
        }
    </div>
</div>
