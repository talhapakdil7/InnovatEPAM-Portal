@model IdeaListViewModel
@{
    ViewData["Title"] = "My Ideas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-collection me-2"></i>My Ideas</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Submit New Idea
    </a>
</div>

<form method="get" class="d-flex gap-2 mb-4">
    <select name="statusFilter" class="form-select w-auto">
        <option value="">All Statuses</option>
        @foreach (var status in Model.AvailableStatuses)
        {
            <option value="@status" selected="@(Model.StatusFilter == status)">@status</option>
        }
    </select>
    <button type="submit" class="btn btn-outline-secondary">
        <i class="bi bi-funnel me-1"></i>Filter
    </button>
    @if (!string.IsNullOrEmpty(Model.StatusFilter))
    {
        <a asp-action="Index" class="btn btn-outline-danger">
            <i class="bi bi-x"></i>Clear
        </a>
    }
</form>

@if (!Model.Ideas.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox display-4"></i>
        <p class="mt-3">No ideas found. <a asp-action="Create">Submit your first idea!</a></p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var idea in Model.Ideas)
        {
            var badgeClass = idea.Status switch
            {
                "Submitted" => "bg-secondary",
                "UnderReview" => "bg-warning text-dark",
                "Accepted" => "bg-success",
                "Rejected" => "bg-danger",
                _ => "bg-secondary"
            };

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0 text-truncate" title="@idea.Title">@idea.Title</h5>
                            <span class="badge @badgeClass ms-2 flex-shrink-0">@idea.Status.Replace("UnderReview", "Under Review")</span>
                        </div>
                        <p class="card-text text-muted small">
                            <i class="bi bi-calendar3 me-1"></i>@idea.CreatedDate.ToString("MMM dd, yyyy")
                        </p>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a asp-action="Detail" asp-route-id="@idea.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye me-1"></i>View Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
