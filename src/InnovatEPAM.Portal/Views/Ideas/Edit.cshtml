@model EditDraftViewModel
@{
    ViewData["Title"] = Model.IsSubmittedEditable ? $"Edit submission — {Model.Title}" : $"Edit draft — {Model.Title}";
    ViewData["BreadcrumbParent"] = "My ideas";
    ViewData["BreadcrumbParentUrl"] = Url.Action("Index", "Ideas");
}

<div class="mt-4 max-w-3xl">

    <!-- Page Header -->
    <div class="flex items-center gap-3 mb-6">
        <a asp-action="Detail" asp-route-id="@Model.Id" class="btn-ghost btn-icon btn-sm text-gray-500">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
        </a>
        <div>
            <div class="flex items-center gap-2 mb-0.5">
                <h1 class="text-xl font-bold text-gray-900">@(Model.IsSubmittedEditable ? "Edit submission" : "Edit draft")</h1>
                @if (Model.IsSubmittedEditable)
                {
                    <span class="badge-submitted">Submitted</span>
                }
                else
                {
                    <span class="badge-draft">Draft</span>
                }
            </div>
            <p class="text-sm text-gray-500 truncate max-w-xs">@Model.Title</p>
        </div>
    </div>

    @if (Model.IsSubmittedEditable)
    {
        <div class="rounded-xl border border-amber-100 bg-amber-50/80 px-4 py-3 mb-6 text-sm text-amber-900">
            You are editing a <strong>submitted</strong> idea; the same validation rules apply before review starts. Withdraw is available on the idea detail page.
        </div>
    }

    <form asp-action="@(Model.IsSubmittedEditable ? "UpdateSubmitted" : "UpdateDraft")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert-error mb-5" role="alert">
            <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
        </div>

        <!-- Category -->
        <div class="form-section">
            <h2 class="form-section-title">
                <span class="w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold flex items-center justify-center flex-shrink-0">1</span>
                Innovation category
            </h2>
            <div class="form-group mb-0">
                <label asp-for="Category" class="form-label">Category <span class="text-red-500">*</span></label>
                <select asp-for="Category" id="categorySelect" class="form-select">
                    <option value="">— Select a category —</option>
                    @foreach (var cat in CategoryDefinitions.All.Values)
                    {
                        <option value="@cat.Key">@cat.DisplayName</option>
                    }
                </select>
                <span asp-validation-for="Category" class="form-error"></span>
            </div>
        </div>

        <!-- Technical Improvement -->
        <div id="section-TechnicalImprovement" class="category-section form-section border-l-4 border-blue-500" style="display:none">
            <h2 class="form-section-title text-blue-700">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2v-4M9 21H5a2 2 0 01-2-2v-4m0 0h18" />
                </svg>
                Technical improvement details
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div class="form-group mb-0">
                    <label asp-for="TechArea" class="form-label">Technology area <span class="text-red-500">*</span></label>
                    <select asp-for="TechArea" class="form-select">
                        <option value="">— Select —</option>
                        @foreach (var opt in CategoryDefinitions.All[CategoryDefinitions.TechnicalImprovement]
                            .Fields.First(f => f.Key == "TechArea").Options)
                        {
                            <option value="@opt">@opt</option>
                        }
                    </select>
                    <span asp-validation-for="TechArea" class="form-error"></span>
                </div>
                <div class="form-group mb-0">
                    <label asp-for="TechEffort" class="form-label">Estimated effort <span class="text-red-500">*</span></label>
                    <select asp-for="TechEffort" class="form-select">
                        <option value="">— Select —</option>
                        @foreach (var opt in CategoryDefinitions.All[CategoryDefinitions.TechnicalImprovement]
                            .Fields.First(f => f.Key == "TechEffort").Options)
                        {
                            <option value="@opt">@opt</option>
                        }
                    </select>
                    <span asp-validation-for="TechEffort" class="form-error"></span>
                </div>
            </div>
            <div class="form-group mt-5 mb-0">
                <label asp-for="TechBenefit" class="form-label">Expected technical benefit <span class="text-red-500">*</span></label>
                <textarea asp-for="TechBenefit" class="form-textarea" rows="4" maxlength="500"></textarea>
                <span asp-validation-for="TechBenefit" class="form-error"></span>
            </div>
        </div>

        <!-- Process Improvement -->
        <div id="section-ProcessImprovement" class="category-section form-section border-l-4 border-emerald-500" style="display:none">
            <h2 class="form-section-title text-emerald-700">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Process improvement details
            </h2>
            <div class="form-group mb-5">
                <label asp-for="ProcDepartment" class="form-label">Affected unit <span class="text-red-500">*</span></label>
                <input asp-for="ProcDepartment" class="form-input" maxlength="100" />
                <span asp-validation-for="ProcDepartment" class="form-error"></span>
            </div>
            <div class="form-group mb-5">
                <label asp-for="ProcPainPoint" class="form-label">Current pain point <span class="text-red-500">*</span></label>
                <textarea asp-for="ProcPainPoint" class="form-textarea" rows="4" maxlength="500"></textarea>
                <span asp-validation-for="ProcPainPoint" class="form-error"></span>
            </div>
            <div class="form-group mb-0">
                <label asp-for="ProcSavings" class="form-label">Estimated savings</label>
                <input asp-for="ProcSavings" class="form-input" maxlength="200" />
                <span asp-validation-for="ProcSavings" class="form-error"></span>
            </div>
        </div>

        <!-- Client Solution -->
        <div id="section-ClientSolution" class="category-section form-section border-l-4 border-violet-500" style="display:none">
            <h2 class="form-section-title text-violet-700">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                Customer solution details
            </h2>
            <div class="form-group mb-5">
                <label asp-for="ClientSegment" class="form-label">Target segment <span class="text-red-500">*</span></label>
                <input asp-for="ClientSegment" class="form-input" maxlength="200" />
                <span asp-validation-for="ClientSegment" class="form-error"></span>
            </div>
            <div class="form-group mb-5">
                <label asp-for="ClientProblem" class="form-label">Customer problem <span class="text-red-500">*</span></label>
                <textarea asp-for="ClientProblem" class="form-textarea" rows="4" maxlength="500"></textarea>
                <span asp-validation-for="ClientProblem" class="form-error"></span>
            </div>
            <div class="form-group mb-0">
                <label asp-for="ClientImpact" class="form-label">Expected business impact <span class="text-red-500">*</span></label>
                <input asp-for="ClientImpact" class="form-input" maxlength="300" />
                <span asp-validation-for="ClientImpact" class="form-error"></span>
            </div>
        </div>

        <!-- Core Idea Info -->
        <div class="form-section">
            <h2 class="form-section-title">
                <span class="w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold flex items-center justify-center flex-shrink-0">2</span>
                Idea summary
            </h2>

            <div class="form-group">
                <label asp-for="Title" class="form-label">Title <span class="text-red-500">*</span></label>
                <input asp-for="Title" class="form-input" placeholder="Short, clear title" maxlength="200" />
                <span asp-validation-for="Title" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-textarea" rows="6" maxlength="2000"
                          placeholder="Describe your idea…"></textarea>
                <p class="form-hint">Optional. Up to 2000 characters.</p>
                <span asp-validation-for="Description" class="form-error"></span>
            </div>

            <!-- Existing Attachment -->
            @if (Model.ExistingAttachment != null)
            {
                <div class="form-group p-3 bg-gray-50 rounded-lg border border-gray-200 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                        </svg>
                        <span class="text-sm text-gray-700 font-medium">@Model.ExistingAttachment.FileName</span>
                        <span class="text-xs text-gray-400">@((Model.ExistingAttachment.FileSize / 1024.0).ToString("F0")) KB</span>
                    </div>
                    <label class="flex items-center gap-2 text-sm text-red-600 cursor-pointer">
                        <input asp-for="RemoveAttachment" type="checkbox" class="rounded border-gray-300 text-red-600" />
                        Remove attachment
                    </label>
                </div>
            }

            <div class="form-group mb-0">
                <label asp-for="Attachment" class="form-label">
                    @(Model.ExistingAttachment != null ? "Replace attachment" : "Attachment")
                </label>
                <input asp-for="Attachment" class="form-input" type="file"
                       accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />
                <p class="form-hint">PDF, DOC, DOCX, XLS, XLSX, JPG, PNG — max 10 MB</p>
                <span asp-validation-for="Attachment" class="form-error"></span>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex flex-wrap items-center gap-3">
            @if (Model.IsSubmittedEditable)
            {
                <button type="submit" class="btn-primary btn-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                    </svg>
                    Save changes
                </button>
            }
            else
            {
                <button type="submit" formaction="@Url.Action("UpdateDraft", new { id = Model.Id })" class="btn-primary btn-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                    </svg>
                    Save draft
                </button>
                <button type="submit" formaction="@Url.Action("SubmitDraft", new { id = Model.Id })" class="btn-success btn-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                    </svg>
                    Submit
                </button>
            }
            <a asp-action="Detail" asp-route-id="@Model.Id" class="btn-ghost">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/category-form.js" asp-append-version="true"></script>
    @if (Model.Category != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                initCategoryForm('@Model.Category');
            });
        </script>
    }
}
